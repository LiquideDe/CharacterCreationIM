--- !u!114 &5140889932447721529
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 25708092556394843}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0421\u043B\u0443\u0436\u0431\u0430 \u2013 \u044D\u0442\u043E \u0432\u0435\u0434\u043E\u043C\u0441\u0442\u0432\u043E,
    \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0432\u044B \u0441\u043E\u0441\u0442\u043E\u0438\u0442\u0435,
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F, \u0447\u0442\u043E
    \u043F\u0440\u0438\u043D\u044F\u043B\u0430 \u0432\u0430\u0441 \u043A \u0441\u0435\u0431\u0435,
    \u0432\u044B\u0440\u0430\u0441\u0442\u0438\u043B\u0430, \u043E\u0431\u0443\u0447\u0438\u043B\u0430
    \u0438 \u0441\u043D\u0430\u0440\u044F\u0434\u0438\u043B\u0430 \u0434\u043B\u044F
    \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u0432\u044B \u043C\u043E\u0433\u043B\u0438
    \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u0435
    \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0438. \r\n\n\u041E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
    \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u043D\u043E\u0441\u0442\u044C
    \u0441\u0432\u043E\u0435\u0433\u043E \u0433\u0435\u0440\u043E\u044F \u043A \u0441\u043B\u0443\u0436\u0431\u0435
    \u043C\u043E\u0436\u043D\u043E \u0434\u0432\u0443\u043C\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u0430\u043C\u0438:\r\n-\u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \u043A\u043D\u043E\u043F\u043A\u0443 \"\u0414\u0430\u043B\u0435\u0435\" \u0438
    \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u043B\u0443\u0436\u0431\u0443
    \u0441\u0430\u043C\u0438 \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u0435
    \u0434\u0430\u0440\u0443\u0435\u043C\u044B\u0435 \u0435\u0439 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430.\r\n-\u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \u043A\u043D\u043E\u043F\u043A\u0443 \"\u0421\u043B\u0443\u0447\u0430\u0439\u043D\u0430\u044F\",
    \u0447\u0442\u043E\u0431\u044B \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
    \u0435\u0451 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E, \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
    75 \u043E\u0447\u043A\u043E\u0432 \u043E\u043F\u044B\u0442\u0430.\r\n\n\u0412\u043C\u0435\u0441\u0442\u043E
    \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C
    \u0447\u0442\u043E-\u043B\u0438\u0431\u043E \u0438\u0437 \u0421\u043B\u0443\u0436\u0431\u044B,
    \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u043E\u043A\u043D\u0435
    \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0430\u0436\u0430\u0442\u044C
    \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443 \"\u0412\u044B\u0431\u0440\u0430\u0442\u044C
    \u0448\u0430\u0431\u043B\u043E\u043D\", \u043F\u0440\u0438 \u0432\u044B\u0431\u043E\u0440\u0435
    \u0444\u0440\u0430\u043A\u0446\u0438\u0438, \u0438 \u0432\u044B\u0431\u0440\u0430\u0442\u044C
    \u043E\u0434\u0438\u043D \u0438\u0437 \u0433\u043E\u0442\u043E\u0432\u044B\u0445
    \u043D\u0430\u0431\u043E\u0440\u043E\u0432, \u0447\u0442\u043E\u0431\u044B \u0443\u0441\u043A\u043E\u0440\u0438\u0442\u044C
    \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: f8035e30d7cbd524591361b71fc29bb7, type: 2}
