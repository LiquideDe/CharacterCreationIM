--- !u!114 &1563275547842825664
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7953557102729070142}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0426\u0438\u0444\u0440\u044B \u043D\u0430 \u043B\u0438\u0441\u0442\u0435
    \u2013 \u044D\u0442\u043E \u043B\u0438\u0448\u044C \u0447\u0430\u0441\u0442\u044C
    \u0432\u0430\u0448\u0435\u0433\u043E \u0433\u0435\u0440\u043E\u044F. \u0412\u0441\u0435
    \u0440\u0435\u0448\u0435\u043D\u0438\u044F, \u0447\u0442\u043E \u0432\u044B \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u043B\u0438
    \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440, \u043E\u0431\u0440\u0438\u0441\u043E\u0432\u044B\u0432\u0430\u043B\u0438
    \u0435\u0433\u043E \u043B\u0438\u0448\u044C \u0432 \u043E\u0431\u0449\u0438\u0445
    \u0447\u0435\u0440\u0442\u0430\u0445 \u2013 \u0433\u0434\u0435 \u0440\u043E\u0434\u0438\u043B\u0441\u044F
    \u0438 \u0447\u0435\u043C \u0436\u0438\u043B \u0434\u043E \u043D\u0430\u0447\u0430\u043B\u0430
    \u0438\u0433\u0440\u044B. \u041F\u0440\u0438\u0448\u043B\u043E \u0432\u0440\u0435\u043C\u044F
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u0441
    \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0441\u0442\u044F\u043C\u0438,
    \u0447\u0442\u043E\u0431\u044B \u0432\u0430\u0448 \u0433\u0435\u0440\u043E\u0439
    \u0441\u0442\u0430\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C
    \u2013 \u043D\u0435\u043F\u043E\u0432\u0442\u043E\u0440\u0438\u043C\u043E\u0439
    \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C\u044E, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
    \u043D\u0435 \u0441\u043F\u0443\u0442\u0430\u0435\u0448\u044C \u0441 \u0434\u0440\u0443\u0433\u0438\u043C
    \u0443\u0440\u043E\u0436\u0435\u043D\u0446\u0435\u043C \u0442\u043E\u0433\u043E
    \u0436\u0435 \u043C\u0438\u0440\u0430, \u0441\u043E\u0441\u0442\u043E\u044F\u0449\u0438\u043C
    \u043D\u0430 \u0442\u043E\u0439 \u0436\u0435 \u0441\u043B\u0443\u0436\u0431\u0435,
    \u0432 \u0442\u043E\u0439 \u0436\u0435 \u0440\u043E\u043B\u0438.  \u041E\u0434\u0438\u043D
    \u0438\u0437 \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u0432 \u0441\u043E\u0437\u0434\u0430\u0442\u044C
    \u0433\u0435\u0440\u043E\u044E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E\u0435
    \u043F\u0440\u043E\u0448\u043B\u043E\u0435 \u2013 \u044D\u0442\u043E \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C
    \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432
    \u043E \u043D\u0451\u043C.\r\n\n\u042D\u0442\u043E \u043E\u043A\u043D\u043E \u043C\u043E\u0436\u043D\u043E
    \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C
    \u043D\u0430\u0436\u0430\u0432 \u043D\u0430 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C\r\n"
  m_isRightToLeft: 0
