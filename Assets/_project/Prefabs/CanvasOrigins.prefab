  m_text: "\u041E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u0441\u0432\u043E\u0435\u0433\u043E \u0433\u0435\u0440\u043E\u044F \u043C\u043E\u0436\u043D\u043E
    \u0434\u0432\u0443\u043C\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u0430\u043C\u0438:\r\n\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \u043A\u043D\u043E\u043F\u043A\u0443 \"\u0421\u043B\u0443\u0447\u0430\u0439\u043D\u043E\",
    \u0447\u0442\u043E\u0431\u044B \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
    \u0435\u0433\u043E \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E, \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
    25 \u043E\u0447\u043A\u043E\u0432 \u043E\u043F\u044B\u0442\u0430.\r\n\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \u043A\u043D\u043E\u043F\u043A\u0443 \"\u0417\u0430\u043A\u0440\u044B\u0442\u044C\"
    \u0438 \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043B\u044E\u0431\u043E\u0439
    \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u0441\u0430\u043C\u0438.\r\n"
